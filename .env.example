VITE_SPECIAL_DAY=default # songkran | valentine | christmas | halloween | default
VITE_SITE_OPEN=true # true: backup site open (current) | false: player.docchula.com back online (redirect)
VITE_AUTOPLAY=true # true / TRUE: autoplay next video when current video ends | false / FALSE: nothing happens
VITE_NEXT_VIDEO_URL="" # Optional URL (YouTube, mp4, etc.) to autoplay when the current video ends
